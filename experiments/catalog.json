{
  "schema": "inside-valdivia.h3-experiment-catalog/1",
  "experiments": [
    {
      "id": "keyframe-mode",
      "operations": [{ "id": "generate.keyframed", "version": 2 }],
      "question": "How does each documented keyframe mode constrain geometry and motion for the same prompt and target?",
      "fixed": ["model", "quantization", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "variant": ["text-only", "first-frame", "last-frame", "first-last"] },
      "measure": ["anchor fidelity at supplied endpoints", "motion coherence", "temporal artifacts"],
      "status": "planned"
    },
    {
      "id": "reference-image-size",
      "operations": [{ "id": "generate.from_references", "version": 4 }],
      "question": "What quality and runtime difference does the official reference-image size mode produce?",
      "fixed": ["model", "resolution", "target_frames", "reference_image", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "ref_image_size": ["match", "max"] },
      "measure": ["reference fidelity", "motion coherence", "runtime_seconds", "peak_vram"],
      "status": "planned"
    },
    {
      "id": "reference-clip-duration",
      "operations": [{ "id": "generate.from_references", "version": 4 }],
      "question": "How much reference motion is retained as a documented-range 24 fps clip changes across valid H3 lengths?",
      "fixed": ["model", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps", "reference motion source"],
      "variable": { "reference_clip_frames": [56, 73, 90, 107, 124] },
      "measure": ["motion correspondence", "appearance drift", "temporal artifacts"],
      "status": "planned"
    },
    {
      "id": "guide-length",
      "operations": [{ "id": "generate.with_guides", "version": 3 }],
      "question": "How does official AddGuide clip length trade contextual motion against free generated range?",
      "fixed": ["model", "resolution", "target_frames", "prompt", "seed", "guide start index", "sampler", "scheduler", "steps"],
      "variable": { "guide_frames": [5, 22, 39, 56, 73, 90, 107] },
      "measure": ["motion departure from guide", "duplicate or frozen frames", "generated-range coherence"],
      "status": "planned"
    },
    {
      "id": "guide-placement",
      "operations": [{ "id": "generate.with_guides", "version": 3 }],
      "question": "How does placement of the same official temporal guide affect the generated range around it?",
      "fixed": ["model", "resolution", "target_frames", "prompt", "seed", "guide clip", "sampler", "scheduler", "steps"],
      "variable": { "frame_idx": [0, 51, 102] },
      "measure": ["pre-guide coherence", "post-guide coherence", "guide reconstruction artifacts"],
      "status": "planned"
    },
    {
      "id": "native-continuation-prompt-relation",
      "operations": [{ "id": "continue.native_av", "version": 3 }],
      "question": "Does the characterized 22-frame native latent tail preserve motion and appearance across one continuation?",
      "fixed": ["model", "resolution", "overlap_frames=22", "sampler", "scheduler", "steps", "continuation target length"],
      "variable": { "prompt_relation": ["same prompt", "controlled prompt continuation"] },
      "measure": ["boundary motion continuity", "identity drift", "suffix diversity", "native latent shape validity"],
      "status": "planned"
    },
    {
      "id": "native-mask-boundary",
      "operations": [{ "id": "complete.native_av", "version": 2 }],
      "question": "How does an official continuous H3 per-token AV mask change preservation and transition quality around the same native completion interval?",
      "fixed": ["native target", "unknown interval", "model", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps", "mask strengths"],
      "variable": { "mask_boundary": ["hard", "17-frame smoothstep", "17-frame smootherstep"] },
      "measure": ["known-token preservation", "left boundary motion", "right boundary motion", "ghosting", "structural-audio shape validity"],
      "status": "planned"
    },
    {
      "id": "native-overlap-transport",
      "operations": [{ "id": "continue.native_av", "version": 3 }],
      "question": "For the same source and suffix request, how does native keyframe overlap compare with official per-token masked overlap?",
      "fixed": ["source native state", "overlap_frames", "extension_frames", "model", "resolution", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "overlap_transport": ["minimax_keyframes", "noise_mask"] },
      "measure": ["boundary motion continuity", "known-tail preservation", "identity drift", "runtime_seconds"],
      "status": "planned"
    },
    {
      "id": "native-future-guide",
      "operations": [{ "id": "continue.native_av", "version": 3 }],
      "question": "Does one official future guide improve arrival fidelity without degrading native overlap continuity?",
      "fixed": ["source native state", "overlap mask", "model", "resolution", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "future_guide": ["absent", "present at frame 119"] },
      "measure": ["arrival fidelity", "overlap continuity", "motion coherence", "guide reconstruction artifact"],
      "status": "planned"
    },
    {
      "id": "masked-edit-edge-profile",
      "operations": [{ "id": "edit.masked_video", "version": 2 }],
      "question": "How does continuous spatial feathering change edit locality and boundary quality for the same static H3 mask?",
      "fixed": ["source native state", "mask geometry", "model", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps", "denoise strengths"],
      "variable": { "spatial_edge_profile": ["hard", "16-pixel smoothstep", "32-pixel smoothstep"] },
      "measure": ["complement preservation", "boundary seam", "halo or ghosting", "edit locality"],
      "status": "planned"
    },
    {
      "id": "outpaint-placement",
      "operations": [{ "id": "reframe.outpaint_video", "version": 2 }],
      "question": "At fixed source and target canvases, how does exact aligned source placement affect H3 outpaint continuity?",
      "fixed": ["source native state", "target canvas", "model", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps", "mask strengths"],
      "variable": { "source_offset": [[0, 32], [32, 32], [64, 32]] },
      "measure": ["source-region preservation", "border continuity", "motion continuity", "composition utility"],
      "status": "planned"
    },
    {
      "id": "native-refinement-strength",
      "operations": [{ "id": "refine.video", "version": 2 }],
      "question": "Does bounded native-state V2V produce useful detail gain before motion or identity drift becomes objectionable?",
      "fixed": ["source native state", "model", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps", "video/audio shifts"],
      "variable": { "video_denoise_strength": [0.1, 0.2, 0.35] },
      "measure": ["detail gain", "motion preservation", "identity drift", "temporal ghosting", "runtime_seconds"],
      "status": "planned"
    },
    {
      "id": "h3-native-temporal-densification",
      "operations": [{ "id": "densify.temporal", "version": 2 }],
      "question": "Can native H3 visual-token dilation create useful slow motion under either same-duration or duration-expansion delivery?",
      "fixed": ["source native AV state", "factor=2", "resolution", "prompt", "seed", "sampler", "scheduler", "steps", "anchor_denoise=0", "gap_denoise=1"],
      "variable": { "delivery_mode": ["same-duration higher-fps", "24fps duration-expansion"] },
      "measure": ["exact output frame count and fps", "new-motion evidence", "anchor drift", "jerk discontinuity", "occlusion quality", "runtime_seconds", "peak_vram"],
      "status": "rejected"
    },
    {
      "id": "h3-native-spatial-regeneration",
      "operations": [{ "id": "regenerate.spatial", "version": 2 }],
      "question": "Which H3-native initial state yields useful spatial detail with the lowest temporal and semantic drift?",
      "fixed": ["source native AV state", "target geometry", "same H3 checkpoint", "same H3 VAE", "prompt", "seed", "sampler", "scheduler", "steps", "audio_denoise=0"],
      "variable": { "variant_and_denoise": ["latent:0.15", "latent:0.25", "latent:0.35", "pixel-vae:0.15", "pixel-vae:0.25", "pixel-vae:0.35"] },
      "measure": ["unchanged frame count and fps", "detail gain over resize control", "temporal shimmer", "identity drift", "runtime_seconds", "peak_vram"],
      "status": "planned"
    },
    {
      "id": "h3-native-enhancement-order",
      "operations": [
        { "id": "regenerate.spatial", "version": 2 },
        { "id": "generate.with_guides", "version": 3 }
      ],
      "question": "Should dense-guide H3 temporal expansion run before or after the accepted same-model spatial regeneration pass?",
      "fixed": ["source native AV state", "factor=2", "accepted spatial variant and denoise", "final geometry", "final fps=24", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "operation_order": ["dense AddGuide expansion -> regenerate.spatial", "regenerate.spatial -> dense AddGuide expansion"] },
      "measure": ["exact final frame count and fps", "detail stability", "new-motion quality", "anchor drift", "temporal shimmer", "runtime_seconds", "peak_vram"],
      "status": "planned"
    },
    {
      "id": "h3-dense-guide-temporal-expansion",
      "operations": [{ "id": "generate.with_guides", "version": 3 }],
      "question": "How far can official target-time AddGuide conditioning expand a contiguous source prefix while retaining useful slow motion near a five-second 24 fps delivery?",
      "fixed": ["source native AV state", "resolved target=124", "delivery fps=24", "model", "prompt", "sampler", "scheduler", "steps", "source_i maps to target_i*factor"],
      "variable": { "factor_and_guide_count": ["2x:60", "3x:40", "4x:30"] },
      "measure": ["exact duration and frame count", "source-anchor fidelity", "inter-anchor cadence", "appearance drift", "motion coherence", "runtime_seconds", "peak RAM and VRAM"],
      "status": "executes"
    },
    {
      "id": "h3-timed-reference-temporal-expansion",
      "operations": [{ "id": "generate.from_references", "version": 4 }],
      "question": "Can Qwen-only timed image references replace target-aligned AddGuide states in sparse 2x temporal expansion?",
      "fixed": ["decoded source offsets", "target times", "factor=2", "source stride=8", "resolution", "prompt intent", "seed", "sampler", "scheduler", "steps", "delivery frames and fps"],
      "variable": { "conditioning_route": ["target-aligned AddGuide", "Qwen-only timed image references"] },
      "measure": ["exact duration and frame count", "source-anchor PSNR and SSIM", "layout integrity", "motion coherence", "runtime_seconds"],
      "status": "rejected"
    },
    {
      "id": "h3-hydra-structural-carrier",
      "operations": [{ "id": "generate.with_control", "version": 1 }],
      "question": "Can a deterministic Hydra IMAGE-sequence transform sit transparently before official H3 Fun Control and produce a causal structural change when explicitly animated?",
      "fixed": ["source video range", "Canny thresholds", "first frame", "prompt", "H3 trunk", "Fun Control patch", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps", "control strength and diffusion interval"],
      "variable": { "carrier_transform": ["direct Canny baseline", "Hydra pass-through", "Hydra time-varying scale and rotation"] },
      "measure": ["carrier PSNR and SSIM", "generated-video PSNR and SSIM", "structural response", "projection preservation", "artifacts", "runtime_seconds"],
      "status": "executes"
    },
    {
      "id": "h3-fl2va-prompt-form",
      "operations": [{ "id": "generate.keyframed", "version": 2 }],
      "question": "For the same first/last pair, does the public H3 FL2VA path structure outperform the known terse learned phrase?",
      "fixed": ["first frame", "last frame", "model", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps"],
      "variable": { "prompt_form": ["terse learned phrase", "concise official path", "timed official path"] },
      "measure": ["prompt sensitivity at fixed seed", "endpoint fidelity", "continuous-path coherence", "early landing or terminal hold", "cuts, dissolves, or resets"],
      "status": "planned"
    },
    {
      "id": "h3-fl2va-camera-semantics",
      "operations": [{ "id": "generate.keyframed", "version": 2 }],
      "question": "Does H3 distinguish optical zoom, physical camera translation, and a recursive spatial traverse under otherwise identical FL2VA text?",
      "fixed": ["first frame", "last frame", "public FL2VA structure", "all wording except the motion clause", "model", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps"],
      "variable": { "motion_clause": ["optical zoom", "physical push", "recursive traverse"] },
      "measure": ["apparent focal-length change", "camera-translation parallax", "occlusion continuity", "motion magnitude", "endpoint fidelity"],
      "status": "planned"
    },
    {
      "id": "h3-fl2va-temporal-profile",
      "operations": [{ "id": "generate.keyframed", "version": 2 }],
      "question": "Can prompt language control the velocity profile of one fixed FL2VA camera path?",
      "fixed": ["first frame", "last frame", "physical push motion", "public FL2VA structure", "model", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps"],
      "variable": { "temporal_profile": ["uniform", "accelerating", "accelerate then land"] },
      "measure": ["optical-flow velocity trace", "jerk discontinuity", "early landing", "terminal hold duration", "endpoint fidelity"],
      "status": "planned"
    },
    {
      "id": "h3-i2va-path-specificity",
      "operations": [{ "id": "generate.keyframed", "version": 2 }],
      "question": "How much path specificity can I2VA absorb before extra timing language stops improving the same forward motion?",
      "fixed": ["first frame", "motion intent", "model", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps"],
      "variable": { "path_specificity": ["single clause", "causal path", "timed path"] },
      "measure": ["direction adherence", "motion magnitude", "acceleration response", "spatial coherence", "unrequested cuts or resets"],
      "status": "planned"
    },
    {
      "id": "h3-ref2va-prompt-form",
      "operations": [{ "id": "generate.from_references", "version": 4 }],
      "question": "Does the public six-section Ref2VA grammar bind whole-video camera motion more reliably than flat label-aware prose?",
      "fixed": ["one reference video", "reference order", "requested camera-motion transfer", "model", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps"],
      "variable": { "prompt_form": ["flat reference instruction", "official six-section"] },
      "measure": ["reference-motion correspondence", "visible-content leakage", "camera-path continuity", "prompt sensitivity at fixed seed", "runtime_seconds"],
      "status": "planned"
    },
    {
      "id": "h3-addguide-prompt-relation",
      "operations": [{ "id": "generate.with_guides", "version": 3 }],
      "question": "For one fixed guide ladder, does explicit gap-generation and retiming language change the motion synthesized between exact target-time guides?",
      "fixed": ["ordered guide states", "guide target indices", "model", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps"],
      "variable": { "prompt_relation": ["neutral continuity", "intermediate motion only", "explicit duration expansion"] },
      "measure": ["guide reconstruction fidelity", "distinct intermediate motion", "freeze or echo rate", "motion cadence", "trajectory continuity"],
      "status": "planned"
    },
    {
      "id": "h3-fun-control-prompt-relation",
      "operations": [{ "id": "generate.with_control", "version": 1 }],
      "question": "At fixed structural control, how does neutral, congruent, or conflicting text divide control authority between Qwen conditioning and Fun Control?",
      "fixed": ["first frame", "control carrier", "control strength", "control interval", "model", "resolution", "target_frames", "seed", "sampler", "scheduler", "steps"],
      "variable": { "prompt_relation": ["text neutral", "text congruent", "text conflicting"] },
      "measure": ["control correspondence", "text adherence", "motion magnitude", "structural distortion", "dominance under conflict"],
      "status": "planned"
    }
  ]
}
