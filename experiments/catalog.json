{
  "schema": "inside-valdivia.h3-experiment-catalog/1",
  "experiments": [
    {
      "id": "E1-keyframe-mode",
      "workflow_spec": "W1",
      "question": "How does each documented keyframe mode constrain geometry and motion for the same prompt and target?",
      "fixed": ["model", "quantization", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "variant": ["text-only", "first-frame", "last-frame", "first-last"] },
      "measure": ["anchor fidelity at supplied endpoints", "motion coherence", "temporal artifacts"],
      "status": "planned"
    },
    {
      "id": "E2-reference-image-size",
      "workflow_spec": "W2",
      "question": "What quality and runtime difference does the official reference-image size mode produce?",
      "fixed": ["model", "resolution", "target_frames", "reference_image", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "ref_image_size": ["match", "max"] },
      "measure": ["reference fidelity", "motion coherence", "runtime_seconds", "peak_vram"],
      "status": "planned"
    },
    {
      "id": "E3-reference-clip-duration",
      "workflow_spec": "W2",
      "question": "How much reference motion is retained as the supplied 24 fps clip length changes on valid H3 lengths?",
      "fixed": ["model", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps", "reference motion source"],
      "variable": { "reference_clip_frames": [22, 39, 56, 73, 90, 107] },
      "measure": ["motion correspondence", "appearance drift", "temporal artifacts"],
      "status": "planned"
    },
    {
      "id": "E4-guide-length",
      "workflow_spec": "W3",
      "question": "How does official AddGuide clip length trade contextual motion against free generated range?",
      "fixed": ["model", "resolution", "target_frames", "prompt", "seed", "guide start index", "sampler", "scheduler", "steps"],
      "variable": { "guide_frames": [5, 22, 39, 56, 73, 90, 107] },
      "measure": ["motion departure from guide", "duplicate or frozen frames", "generated-range coherence"],
      "status": "planned"
    },
    {
      "id": "E5-guide-placement",
      "workflow_spec": "W3",
      "question": "How does placement of the same official temporal guide affect the generated range around it?",
      "fixed": ["model", "resolution", "target_frames", "prompt", "seed", "guide clip", "sampler", "scheduler", "steps"],
      "variable": { "frame_idx": [0, 51, 102] },
      "measure": ["pre-guide coherence", "post-guide coherence", "guide reconstruction artifacts"],
      "status": "planned"
    },
    {
      "id": "E6-native-continuation-baseline",
      "workflow_spec": "W4",
      "question": "Does the characterized 22-frame native latent tail preserve motion and appearance across one continuation?",
      "fixed": ["model", "resolution", "overlap_frames=22", "sampler", "scheduler", "steps", "continuation target length"],
      "variable": { "prompt_relation": ["same prompt", "controlled prompt continuation"] },
      "measure": ["boundary motion continuity", "identity drift", "suffix diversity", "native latent shape validity"],
      "status": "planned"
    },
    {
      "id": "E7-two-sided-guide-length",
      "workflow_spec": "W5",
      "question": "Which valid two-sided guide length gives H3 enough outgoing and incoming motion context without overconstraining the generated range?",
      "fixed": ["left source", "right source", "model", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "guide_frames": [5, 22, 39] },
      "measure": ["left boundary motion", "right boundary motion", "accepted-range coherence", "duplicate or frozen frames"],
      "status": "planned"
    },
    {
      "id": "E8-motion-reference-map",
      "workflow_spec": "W6",
      "question": "Which inspectable decoded reference construction produces the strongest usable motion correspondence through official Ref2VA conditioning?",
      "fixed": ["source frames", "reference duration", "model", "resolution", "target_frames", "prompt", "seed", "sampler", "scheduler", "steps"],
      "variable": { "map_family": ["affine", "perspective", "depth-camera", "external-displacement", "advection"] },
      "measure": ["reference clip validity", "motion correspondence", "appearance stability", "failure mode"],
      "status": "planned"
    }
  ]
}
