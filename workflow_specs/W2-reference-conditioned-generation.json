{
  "schema": "inside-valdivia.h3-workflow-spec/1",
  "id": "W2",
  "version": 2,
  "name": "H3 reference-conditioned generation",
  "implementation_class": "official-h3",
  "operation": "Generate one native H3 target from a prompt and arbitrary reference images or 24 fps reference clips.",
  "input_contract": [
    { "name": "prompt", "type": "STRING", "required": true },
    { "name": "reference_images", "type": "IMAGE", "required": false, "cardinality": "zero to nine images" },
    { "name": "reference_clips", "type": "IMAGE", "required": false, "cardinality": "zero to three 24 fps frame batches" },
    { "name": "seed", "type": "INT", "required": true }
  ],
  "output_contract": [
    { "name": "generated_frames", "type": "IMAGE", "required": true, "cardinality": "target frame count" },
    { "name": "native_av_latent", "type": "LATENT", "required": false, "cardinality": "one packed H3 AV latent" }
  ],
  "constraints": {
    "frame_rate": 24,
    "frame_count_rule": "17k+5",
    "preferred_frame_count_range": [124, 362],
    "reference_clip_count_range": [0, 3],
    "reference_image_count_range": [0, 9],
    "reference_clip_min_frames": 5,
    "audio_reference_inputs": false,
    "fixed_soundtrack_conditioning": false
  },
  "graph_contract": [
    { "order": 1, "owner": "vanilla-comfy", "node_type": null, "role": "load the selected Ref2VA model and required model components" },
    { "order": 2, "owner": "official-comfy", "node_type": "MiniMaxH3ReferenceToVideo", "role": "encode ordered Picture and Video references and create a fresh packed AV latent" },
    { "order": 3, "owner": "official-comfy", "node_type": "MiniMaxH3SigmaShift", "role": "set coherent flow shifts" },
    { "order": 4, "owner": "vanilla-comfy", "node_type": null, "role": "apply explicit guider, scheduler, sampler, and seed" },
    { "order": 5, "owner": "vanilla-comfy", "node_type": null, "role": "decode visual frames and save outputs" }
  ],
  "variants": [
    { "id": "image-reference-match", "ref_image_size": "match" },
    { "id": "image-reference-max", "ref_image_size": "max" },
    { "id": "video-reference", "reference_clips": true }
  ],
  "evidence": {
    "deterministic_layer": "documented-upstream",
    "model_layer": "requires per-run execution and visual evaluation"
  }
}
