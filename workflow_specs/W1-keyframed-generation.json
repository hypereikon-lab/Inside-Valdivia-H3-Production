{
  "schema": "inside-valdivia.h3-workflow-spec/1",
  "id": "W1",
  "version": 1,
  "name": "H3 keyframed generation",
  "operation": "Generate one native H3 target from a prompt with optional first and last anchor frames.",
  "input_contract": [
    { "name": "prompt", "type": "STRING", "required": true },
    { "name": "first_frame", "type": "IMAGE", "required": false, "cardinality": "one frame" },
    { "name": "last_frame", "type": "IMAGE", "required": false, "cardinality": "one frame" },
    { "name": "seed", "type": "INT", "required": true }
  ],
  "output_contract": [
    { "name": "generated_frames", "type": "IMAGE", "required": true, "cardinality": "target frame count" },
    { "name": "native_av_latent", "type": "LATENT", "required": false, "cardinality": "one packed H3 AV latent" }
  ],
  "constraints": {
    "frame_rate": 24,
    "frame_count_rule": "17k+5",
    "preferred_frame_count_range": [124, 362],
    "geometry_multiple": 32,
    "fixed_soundtrack_conditioning": false
  },
  "graph_contract": [
    { "order": 1, "owner": "vanilla-comfy", "node_type": null, "role": "load the selected FL2VA model, text encoder, video VAE, and structural-audio VAE" },
    { "order": 2, "owner": "official-comfy", "node_type": "MiniMaxH3ImageToVideo", "role": "create conditioning and a fresh packed AV latent; optional first/last frames select T2VA, I2VA, L2VA, or FL2VA without changing the graph family" },
    { "order": 3, "owner": "official-comfy", "node_type": "MiniMaxH3SigmaShift", "role": "set coherent video and structural-audio flow shifts" },
    { "order": 4, "owner": "vanilla-comfy", "node_type": null, "role": "apply the explicit guider, scheduler, sampler, and seed" },
    { "order": 5, "owner": "vanilla-comfy", "node_type": null, "role": "decode visual frames and save the selected outputs" }
  ],
  "variants": [
    { "id": "text-only", "first_frame": false, "last_frame": false },
    { "id": "first-frame", "first_frame": true, "last_frame": false },
    { "id": "last-frame", "first_frame": false, "last_frame": true },
    { "id": "first-last", "first_frame": true, "last_frame": true }
  ],
  "evidence": {
    "deterministic_layer": "documented-upstream",
    "model_layer": "requires per-run execution and visual evaluation"
  }
}
