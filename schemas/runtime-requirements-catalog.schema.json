{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/inside-valdivia-runtime-requirements-catalog-1.json",
  "type": "object",
  "required": ["schema", "profiles"],
  "properties": {
    "schema": {"const": "inside-valdivia.runtime-requirements-catalog/1"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "purpose"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^runtime/requirements/.+\\.json$"},
          "purpose": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
