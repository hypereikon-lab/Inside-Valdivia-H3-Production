{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/inside-valdivia-cauce-node-lock-1.json",
  "type": "object",
  "required": ["schema", "source", "nodes"],
  "properties": {
    "schema": { "const": "inside-valdivia.cauce-node-lock/1" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "bundle_hash"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "bundle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class_type", "display_name", "category"],
        "properties": {
          "class_type": { "type": "string", "pattern": "^Cauce[A-Za-z0-9]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "pattern": "^CAUCE/" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
