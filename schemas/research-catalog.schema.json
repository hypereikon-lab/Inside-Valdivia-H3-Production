{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/h3-research-catalog-1.json",
  "type": "object",
  "required": ["schema", "as_of", "truth_levels", "tracks", "radar"],
  "properties": {
    "schema": { "const": "inside-valdivia.h3-research-catalog/1" },
    "as_of": { "type": "string", "format": "date" },
    "truth_levels": {
      "const": [
        "source-fact",
        "community-report",
        "project-hypothesis",
        "project-executes",
        "project-repeat-supported",
        "project-rejected"
      ]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priority", "question", "state", "evidence", "experiment_ids", "next_actions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
          "question": { "type": "string", "minLength": 1 },
          "state": { "enum": ["active", "queued", "deferred", "closed"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "claim"],
              "properties": {
                "level": { "type": "string" },
                "claim": { "type": "string", "minLength": 1 },
                "source": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "experiment_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "next_actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "radar": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "url", "watch", "cadence", "last_observed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "class": { "enum": ["official", "upstream", "community", "research"] },
          "url": { "type": "string", "format": "uri" },
          "watch": { "type": "string", "minLength": 1 },
          "cadence": { "enum": ["before-batch", "daily", "weekly"] },
          "last_observed": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
