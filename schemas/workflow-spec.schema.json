{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/h3-workflow-spec-1.json",
  "title": "H3 workflow specification",
  "type": "object",
  "required": [
    "schema", "id", "version", "name", "operation", "input_contract",
    "output_contract", "constraints", "graph_contract", "evidence"
  ],
  "properties": {
    "schema": { "const": "inside-valdivia.h3-workflow-spec/1" },
    "id": { "pattern": "^W[1-7]$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "input_contract": {
      "type": "array",
      "items": { "$ref": "#/$defs/port" }
    },
    "output_contract": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/port" }
    },
    "constraints": { "type": "object" },
    "graph_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "owner", "role"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "owner": { "enum": ["official-comfy", "external-pack", "cauce", "vanilla-comfy"] },
          "node_type": { "type": ["string", "null"] },
          "role": { "type": "string", "minLength": 1 },
          "repeatable": { "type": "boolean" },
          "optional": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "variants": { "type": "array", "items": { "type": "object" } },
    "evidence": {
      "type": "object",
      "required": ["deterministic_layer", "model_layer"],
      "properties": {
        "deterministic_layer": { "type": "string" },
        "model_layer": { "type": "string" }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "cardinality": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
