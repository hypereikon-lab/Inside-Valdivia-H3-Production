{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/comfy-run-receipt-2.json",
  "type": "object",
  "required": ["schema", "created_at", "prompt_id", "operation", "operation_version", "operation_contract_hash", "evidence_status", "api_graph_hash", "runtime_manifest_hash", "artifacts", "receipt_hash"],
  "properties": {
    "schema": { "const": "comfy.run-receipt/2" },
    "created_at": { "type": "string", "format": "date-time" },
    "prompt_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "operation_version": { "type": "integer", "minimum": 1 },
    "operation_contract_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_status": { "enum": ["schema-validated", "executes", "visually-accepted", "rejected", "blocked"] },
    "api_graph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtime_manifest_hash": { "type": ["string", "null"] },
    "history_hash": { "type": ["string", "null"] },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
