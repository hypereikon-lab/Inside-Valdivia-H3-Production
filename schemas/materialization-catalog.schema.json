{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/inside-valdivia-materialization-catalog-1.json",
  "title": "Canonical H3 materialization queue",
  "type": "object",
  "required": ["schema", "plans"],
  "properties": {
    "schema": { "const": "inside-valdivia.materialization-catalog/1" },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "priority", "operation", "operation_version",
          "operation_contract_hash", "variant", "topology_key", "plan", "state"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 1 },
          "operation": { "type": "string" },
          "operation_version": { "type": "integer", "minimum": 1 },
          "operation_contract_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "variant": { "type": "string", "minLength": 1 },
          "topology_key": { "type": "string", "minLength": 3 },
          "plan": { "type": "string", "pattern": "^materialization/plans/.+\\.json$" },
          "state": { "const": "offline-ready" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
