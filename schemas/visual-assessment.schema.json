{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/inside-valdivia-visual-assessment-1.json",
  "type": "object",
  "required": ["schema", "id", "invocation", "operation", "operation_version", "variant", "run_receipt", "artifact", "reviewer", "reviewed_at", "technical_checks", "visual_checks", "verdict", "notes"],
  "properties": {
    "schema": {"const": "inside-valdivia.visual-assessment/1"},
    "id": {"type": "string", "minLength": 1},
    "invocation": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "operation_version": {"type": "integer", "minimum": 1},
    "variant": {"type": "string", "minLength": 1},
    "run_receipt": {"type": "string", "minLength": 1},
    "artifact": {
      "type": "object",
      "required": ["filename", "subfolder", "type"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "subfolder": {"type": "string"},
        "type": {"enum": ["output", "temp"]}
      },
      "additionalProperties": false
    },
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "technical_checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "visual_checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "verdict": {"enum": ["visually-accepted", "rejected", "mixed"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
