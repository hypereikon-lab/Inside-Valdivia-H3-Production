{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/inside-valdivia-cauce-archetype-lock-1.json",
  "type": "object",
  "required": ["schema", "source", "archetypes"],
  "properties": {
    "schema": { "const": "inside-valdivia.cauce-archetype-lock/1" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "catalog_hash"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "catalog_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topology_signature", "topology_keys"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "topology_signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "topology_keys": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
