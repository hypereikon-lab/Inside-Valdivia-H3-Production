{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/production-segment-2.json",
  "title": "Editorial segment",
  "type": "object",
  "required": ["schema", "id", "frame_rate", "frame_range", "sources", "status"],
  "properties": {
    "schema": { "const": "inside-valdivia.production-segment/2" },
    "id": { "type": "string", "minLength": 1 },
    "frame_rate": { "const": 24 },
    "frame_range": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["invocation", "output"],
        "properties": {
          "invocation": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 },
          "accepted_range": {
            "type": "array",
            "prefixItems": [
              { "type": "integer", "minimum": 0 },
              { "type": "integer", "minimum": 1 }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "additionalProperties": false
      }
    },
    "status": { "enum": ["planned", "assembled", "visually-accepted", "rejected", "blocked"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
