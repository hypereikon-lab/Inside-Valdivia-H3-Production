{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/h3-experiment-1.json",
  "type": "object",
  "required": ["id", "operations", "question", "fixed", "variable", "measure", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "version": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "question": { "type": "string", "minLength": 1 },
    "fixed": { "type": "array", "items": { "type": "string" } },
    "variable": { "type": "object", "minProperties": 1 },
    "measure": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": { "enum": ["planned", "schema-validated", "executes", "visually-accepted", "rejected", "blocked"] }
  },
  "additionalProperties": false
}
