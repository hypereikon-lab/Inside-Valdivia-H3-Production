{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypereikon.online/schemas/h3-prompting-catalog-1.json",
  "type": "object",
  "required": ["schema", "source", "policy", "matrices"],
  "properties": {
    "schema": { "const": "inside-valdivia.h3-prompting-catalog/1" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "observed_at", "files"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "observed_at": { "type": "string", "format": "date" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["language", "media_semantics", "generated_audio", "comparison_unit"],
      "properties": {
        "language": { "const": "English" },
        "media_semantics": { "const": "opaque-human-authored-intent" },
        "generated_audio": { "const": "disabled" },
        "comparison_unit": { "const": "one-prompt-variable" }
      },
      "additionalProperties": false
    },
    "matrices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "experiment_id", "stage", "mode", "operation", "target", "fixed", "variants", "measures", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "experiment_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "stage": { "type": "integer", "minimum": 1, "maximum": 3 },
          "mode": { "enum": ["I2VA", "FL2VA", "Ref2VA", "AddGuide", "FunControl"] },
          "operation": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
              "version": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "required": ["fps", "frames", "duration_seconds"],
            "properties": {
              "fps": { "const": 24 },
              "frames": { "type": "integer", "minimum": 5 },
              "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          },
          "fixed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "variants": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "hypothesis", "prompt"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "hypothesis": { "type": "string", "minLength": 1 },
                "prompt": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "measures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "status": { "enum": ["planned", "executes", "visually-accepted", "rejected"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
