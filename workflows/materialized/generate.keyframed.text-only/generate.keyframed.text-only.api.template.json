      },
      "format": "auto",
      "format.codec": "auto",
      "video": [
        "12",
        0
      ]
    }
  },
  "2": {
    "_meta": {
      "title": "Load H3 video VAE"
    },
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "3": {
    "_meta": {
      "title": "Load H3 FL2VA"
