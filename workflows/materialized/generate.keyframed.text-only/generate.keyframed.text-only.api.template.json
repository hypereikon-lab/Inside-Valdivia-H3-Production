      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "device": "default",
      "type": "minimax"
    }
  },
  "10": {
    "_meta": {
      "title": "Retain native H3 state"
    },
    "class_type": "CauceSaveAVLatent",
