  },
  "6": {
    "_meta": {
      "title": "Basic guider"
    },
    "class_type": "BasicGuider",
    "inputs": {
      "conditioning": [
        "4",
        0
      ],
      "model": [
        "3",
        0
      ]
    }
  },
  "7": {
    "_meta": {
      "title": "H3 scheduler"
    },
    "class_type": "BasicScheduler",
