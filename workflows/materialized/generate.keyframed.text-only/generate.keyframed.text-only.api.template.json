      },
      "filename_prefix": {
        "$binding": "native_state_prefix"
      },
      "latent": [
        "9",
        0
      ]
    }
  },
  "11": {
    "_meta": {
      "title": "Decode video only"
    },
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "9",
        0
      ],
      "vae": [
        "2",
        0
      ]
    }
  },
  "12": {
    "_meta": {
      "title": "Create silent 24 fps video"
    },
    "class_type": "CreateVideo",
    "inputs": {
