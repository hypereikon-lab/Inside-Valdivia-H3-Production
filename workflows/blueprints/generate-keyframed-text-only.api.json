{
  "1": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": { "title": "Load H3 Qwen encoder" }
  },
  "2": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    },
    "_meta": { "title": "Load H3 video VAE" }
  },
  "3": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load H3 FL2VA" }
  },
  "4": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["1", 0],
      "vae": ["2", 0],
      "prompt": "Describe one continuous visual shot and its intended motion. Do not request dialogue, music, sound effects, or generated audio.",
      "width": 1344,
      "height": 768,
      "length": 124
    },
    "_meta": { "title": "H3 text-only conditioning" }
  },
  "5": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    },
    "_meta": { "title": "Seed" }
  },
  "6": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["3", 0],
      "conditioning": ["4", 0]
    },
    "_meta": { "title": "Basic guider" }
  },
  "7": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["3", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    },
    "_meta": { "title": "H3 scheduler" }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "_meta": { "title": "H3 sampler" }
  },
  "9": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["5", 0],
      "guider": ["6", 0],
      "sampler": ["8", 0],
      "sigmas": ["7", 0],
      "latent_image": ["4", 1]
    },
    "_meta": { "title": "Sample H3" }
  },
  "10": {
    "class_type": "CauceSaveAVLatent",
    "inputs": {
      "latent": ["9", 0],
      "filename_prefix": "cauce/latents/inside-valdivia/keyframed-text-only",
      "artifact_index": 1
    },
    "_meta": { "title": "Retain native H3 state" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["2", 0]
    },
    "_meta": { "title": "Decode video only" }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": 24.0,
      "bit_depth": 8
    },
    "_meta": { "title": "Create silent 24 fps video" }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "video/inside-valdivia/keyframed-text-only",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "Save silent video" }
  }
}
